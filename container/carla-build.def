Bootstrap: docker
From: ubuntu:18.04

%post
    # Update and install dependencies
    apt-get update
    apt-get install -y \
        build-essential \
        clang-8 \
        lld-8 \
        g++-7 \
        cmake \
        ninja-build \
        libvulkan1 \
        python3-dev \
        python3-pip \
        libpng-dev \
        libtiff5-dev \
        libjpeg-dev \
        tzdata \
        sed \
        curl \
        wget \
        unzip \
        autoconf \
        libtool \
        rsync \
        libxml2-dev \
        git
    
    # Clean up
    apt-get clean
    rm -rf /var/lib/apt/lists/*
    
    # Install Python packages
    pip3 install --upgrade pip
    pip3 install numpy

%environment
    export CC=clang-8
    export CXX=clang++-8
    export PATH=/usr/local/bin:$PATH

%runscript
    exec /bin/bash "$@"
